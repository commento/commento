[Unit]
Description=Commento touch instrument kiosk
After=systemd-user-sessions.service sound.target
Wants=sound.target
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
PAMName=login
WorkingDirectory=@HOME@
Environment=HOME=@HOME@
Environment=DISPLAY=:0
Environment=COMMENTO_DISPLAY_MODE=1920x1200
Environment=COMMENTO_KIOSK=1
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
ExecStart=/usr/bin/xinit /opt/commento/bin/start-commento-kiosk -- :0 vt1 -keeptty -nolisten tcp
Restart=always
RestartSec=2
KillMode=control-group
Nice=-5
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
